{
  "name": "kensar_pos_desktop",
  "version": "1.0.18",
  "description": "",
  "main": "main.js",
  "scripts": {
    "build:pos-ui": "npm --prefix ../kensar_frontend run build:desktop-pos",
    "start": "npm run start:local:api",
    "start:prod": "npm run build:pos-ui && electron .",
    "start:local": "npm run build:pos-ui && POS_ENV=local electron .",
    "start:local:api": "npm run build:pos-ui && POS_ENV=local POS_API_BASE_URL=http://127.0.0.1:8000 POS_DISABLE_PRINT_AGENT=1 electron .",
    "pack": "npm run build:pos-ui && electron-builder --dir",
    "dist": "npm run build:pos-ui && electron-builder --publish=never",
    "dist:win": "npm run build:pos-ui && electron-builder --win --publish=never",
    "dist:publish": "npm run build:pos-ui && electron-builder --publish=always",
    "dist:win:publish": "npm run build:pos-ui && electron-builder --win --publish=always",
    "test": "node --test test/*.test.js",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.kensar.metrikpos",
    "productName": "Metrik POS - Caja",
    "files": [
      "main.js",
      "preload.js",
      "local-store.js",
      "connectivity-state.js",
      "diagnostics.js",
      "health-probe.js",
      "renderer/**",
      "pos-ui/**",
      "package.json",
      "update-controller.js"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Kennetox",
        "repo": "kensar_pos_desktop"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "MetrikPOS-Setup.${ext}",
      "icon": "assets/metriklogo_square.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Metrik POS - Caja"
    }
  }
}
